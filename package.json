{
  "name": "mmd-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "start:server": "tsx server/src/index.ts",
    "check:server": "tsc -p server/tsconfig.json",
    "test:server": "node --import tsx --test server/test/*.test.ts",
    "test:motion": "node --import tsx --test test/*.test.mjs tests/*.test.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/encoding-japanese": "^2.2.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@google/generative-ai": "^0.24.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/three": "^0.184.1",
    "ammo.js": "^0.0.10",
    "encoding-japanese": "^2.2.0",
    "fastify": "^5.12.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "three": "^0.160.0",
    "three-mesh-bvh": "^0.9.10",
    "three-stdlib": "^2.36.1",
    "zod": "^4.6.5"
  }
}
